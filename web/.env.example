# Copy to .env.local and fill in. Never commit the real file.
DATABASE_URL=postgres://thuna@localhost:5458/thuna
SESSION_SECRET=                 # 32+ random characters
APP_URL=http://localhost:3840
NEXT_PUBLIC_BRAND_NAME=Thuna

# Admin panel password: bcrypt hash, base64-encoded (raw bcrypt $ signs break .env expansion)
ADMIN_PASSWORD_HASH_B64=

# AI
ANTHROPIC_API_KEY=
GEMINI_API_KEY=                 # optional — enable Gemini models in admin Settings

# Phone push (generate with: node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Payments — without these (and outside production) a TEST gateway is used
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS sign-in codes — without these (and outside production) the code is shown on screen
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Where photos/selfies are stored (persistent disk in production)
UPLOAD_DIR=
